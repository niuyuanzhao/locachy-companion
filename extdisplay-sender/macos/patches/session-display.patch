     /// `restoreOrigin` overrides that saved arrangement (see manageOrigin);
     /// `onOriginChange` reports where the display sits afterwards, so the
     /// caller can persist user drags.
+    static func scaledModes(pointsWide: Int, pointsHigh: Int, scale: Int, maxPixelsPerAxis: Int) -> [CGVirtualDisplayMode] {
+        let nativeW = pointsWide * scale
+        let nativeH = pointsHigh * scale
+        let divisors: [Double] = scale == 2 ? [2.0, 1.75, 1.5, 1.25, 1.0] : [1.0]
+        var seen = Set<String>()
+        var list: [CGVirtualDisplayMode] = []
+        for d in divisors {
+            let w = max(2, Int((Double(nativeW) / d).rounded()) & ~1)
+            let h = max(2, Int((Double(nativeH) / d).rounded()) & ~1)
+            guard w * scale <= maxPixelsPerAxis, h * scale <= maxPixelsPerAxis else { continue }
+            let key = "\(w)x\(h)"
+            if seen.insert(key).inserted {
+                list.append(CGVirtualDisplayMode(width: UInt(w), height: UInt(h), refreshRate: 60))
+            }
+        }
+        if list.isEmpty {
+            list.append(CGVirtualDisplayMode(width: UInt(pointsWide), height: UInt(pointsHigh), refreshRate: 60))
+        }
+        return list
+    }
